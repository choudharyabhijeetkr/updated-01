{
  "name": "playwright-test-automation",
  "version": "1.0.0",
  "description": "End-to-end test automation framework with web dashboard and HTML reporting",
  "main": "server/index.js",
  "scripts": {
    "dev": "node server/index.js",
    "start": "node server/index.js",
    "build": "tsc",
    "lint": "tsc --noEmit",
    "server": "node server/index.js",
    "test:dev": "npx playwright test --config=playwright.config.ts",
    "test:headed": "npx playwright test --config=playwright.config.ts --headed"
  },
  "dependencies": {
    "express": "^4.18.2",
    "exceljs": "^4.4.0",
    "glob": "^10.3.10",
    "open": "^10.0.3",
    "os": "^0.1.2",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.41.0",
    "typescript": "^5.3.3"
  }
}